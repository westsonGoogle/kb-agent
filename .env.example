# 任何 OpenAI 兼容的 /chat/completions 端点都可以
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# 推理型模型可设 none/low/medium/high,留空则不发送
# LLM_REASONING_EFFORT=none

# 某些网关要求额外请求头(JSON)
# LLM_EXTRA_HEADERS={"x-opencode-session":"kb-agent"}

KB_DATA_DIR=data
KB_TOP_K=6
KB_CHUNK_CHARS=800
KB_CHUNK_OVERLAP=120
